# Copia este archivo como .env y completa los valores. En Vercel, defínelos en
# Project Settings → Environment Variables (sin el prefijo VITE_: nunca deben llegar al navegador).
TURSO_URL="libsql://<base>-<organizacion>.turso.io"
TURSO_TOKEN="<token de Turso>"

# --- Cloudflare R2 (imágenes de los diagramas AS-IS / TO-BE) ---
# Crea el bucket y aplica la política CORS con: npm run r2:setup
R2_ACCOUNT_ID="<id de la cuenta>"
R2_BUCKET_NAME="<nombre del bucket>"
R2_ACCESS_KEY_ID="<access key>"
R2_SECRET_ACCESS_KEY="<secret key>"
R2_S3_API="https://<account>.r2.cloudflarestorage.com"
# URL pública del bucket (opcional; las imágenes se sirven por la API con URL prefirmada)
R2_PUBLIC_URL="https://<bucket>.<subdominio>.r2.dev"
# Orígenes permitidos por CORS, separados por coma (opcional, por defecto "*")
# R2_ALLOWED_ORIGINS="https://tu-app.vercel.app,http://localhost:5173"
